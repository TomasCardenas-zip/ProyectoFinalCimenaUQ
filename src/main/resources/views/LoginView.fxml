<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" prefWidth="400.0" prefHeight="450.0"
      style="-fx-background-color: #1a1a2e; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ProyectoFinal.controllers.LoginController">

    <children>
        <Label text="CinemaUQ" textFill="#e94560">
            <font>
                <Font name="System Bold" size="28.0" />
            </font>
        </Label>

        <Label text="Iniciar Sesión" textFill="#ffffff">
            <font>
                <Font size="16.0" />
            </font>
        </Label>

        <VBox spacing="5.0" alignment="CENTER_LEFT">
            <Label text="Correo Electrónico:" textFill="#dcdcdc" />
            <TextField fx:id="txtCorreo" promptText="cliente@uniquindio.edu.co"
                       style="-fx-background-radius: 5; -fx-padding: 8;" />
        </VBox>

        <VBox spacing="5.0" alignment="CENTER_LEFT">
            <Label text="Contraseña:" textFill="#dcdcdc" />
            <PasswordField fx:id="txtPassword" promptText="••••••••"
                           style="-fx-background-radius: 5; -fx-padding: 8;" />
        </VBox>

        <Button text="Ingresar al Sistema" onAction="#handleLogin" prefWidth="200.0"
                style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 5;" />
    </children>
</VBox>